# Apache VirtualHost configuration template for SimpleSAMLphp
#
# The Define directives below map Apache configuration variables from the
# corresponding shell/environment variables.  Default values are set in
# docker-entrypoint.sh before this template is processed with envsubst(1).
#
# Environment variables consumed (with defaults from the entrypoint):
#   DOMAIN_NAME           – base domain                  (se.lemche.net)
#   SERVER_NAME           – short hostname               (simplesamlphp)
#   SERVER_ALIAS          – additional name              (${SERVER_NAME})
#   FQDN                  – fully-qualified host name    (${SERVER_NAME}.${DOMAIN_NAME})
#   WEBMASTER             – admin e-mail address         (webmaster@${DOMAIN_NAME})
#   SSL_CERTIFICATE_FILE  – path to TLS certificate      (/etc/ssl/certs/${FQDN}.crt)
#   SSL_PRIVATE_KEY_FILE  – path to TLS private key      (/etc/ssl/private/${FQDN}.key)

# ---------------------------------------------------------------------------
# Apache variable definitions (values injected by envsubst at container start)
# ---------------------------------------------------------------------------
Define DOMAIN_NAME          ${DOMAIN_NAME}
Define SERVER_NAME          ${SERVER_NAME}
Define SERVER_ALIAS         ${SERVER_ALIAS}
Define FQDN                 ${FQDN}
Define WEBMASTER            ${WEBMASTER}
Define SSL_CERTIFICATE_FILE ${SSL_CERTIFICATE_FILE}
Define SSL_PRIVATE_KEY_FILE ${SSL_PRIVATE_KEY_FILE}

# ---------------------------------------------------------------------------
# Server-wide security and compatibility settings
# These directives are active at global (server) scope and must appear
# outside VirtualHost blocks.
# ---------------------------------------------------------------------------

#
# ServerAdmin: Your address, where problems with the server should be
# e-mailed.  This address appears on some server-generated pages, such
# as error documents.  e.g. admin@your-domain.com
#
ServerAdmin ${WEBMASTER}

#
# ServerTokens
# This directive configures what you return as the Server HTTP response
# Header. The built-in default is 'Full' which sends information about
# the OS-type and compiled in modules.  The recommended value is 'Prod'
# which sends the least information.
# Set to one of:  Full | OS | Minor | Minimal | Major | Prod
# where Full conveys the most information, and Prod the least.
#
ServerTokens Prod

#
# Optionally add a line containing the server version and virtual host
# name to server-generated pages (internal error documents, FTP directory
# listings, mod_status and mod_info output etc., but not CGI generated
# documents or custom error documents).
# Set to "EMail" to also include a mailto: link to the ServerAdmin.
# Set to one of:  On | Off | EMail
#
ServerSignature Off

#
# The AllowEncodedSlashes directive allows URLs which contain encoded
# path separators (%2F for / and additionally %5C for \ on according
# systems) to be used. Normally such URLs are refused with a 404 (Not
# found) error.
#
AllowEncodedSlashes On

# ---------------------------------------------------------------------------
# Correlation / request ID log format
# Includes the Apache mod_unique_id value (UNIQUE_ID) so every access-log
# entry can be correlated with the X-Request-ID response header seen by the
# client.
# ---------------------------------------------------------------------------
LogFormat "%h %l %u %t \"%r\" %>s %O \"%{Referer}i\" \"%{User-Agent}i\" rid=%{UNIQUE_ID}e" combined_reqid

# ---------------------------------------------------------------------------
# HTTP → HTTPS redirect
# ---------------------------------------------------------------------------
<VirtualHost *:80>
    ServerName   ${FQDN}
    ServerAlias  ${SERVER_ALIAS}
    ServerAdmin  ${WEBMASTER}

    RewriteEngine On
    RewriteRule ^/?(.*) https://${FQDN}/$1 [R=301,L]
</VirtualHost>

# ---------------------------------------------------------------------------
# HTTPS VirtualHost
# ---------------------------------------------------------------------------
<VirtualHost *:443>
    ServerName   ${FQDN}
    ServerAlias  ${SERVER_ALIAS}
    ServerAdmin  ${WEBMASTER}

    DocumentRoot /var/www/html

    # ---------------------------------------------------------------------------
    # SimpleSAMLphp – expose the public/ directory under /simplesaml
    # ---------------------------------------------------------------------------
    Alias /simplesaml /var/simplesamlphp/public

    <Directory /var/simplesamlphp/public>
        Options FollowSymLinks
        AllowOverride All
        Require all granted

        # Required for SimpleSAMLphp routing
        RewriteEngine On
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteRule ^(.*)$ index.php [QSA,L]
    </Directory>

    # Deny access to sensitive directories
    <Directory /var/simplesamlphp/config>
        Require all denied
    </Directory>
    <Directory /var/simplesamlphp/metadata>
        Require all denied
    </Directory>
    <Directory /var/simplesamlphp/cert>
        Require all denied
    </Directory>

    # ---------------------------------------------------------------------------
    # SSL Configuration
    # Ensure that data in transit is encrypted
    # ---------------------------------------------------------------------------
    SSLEngine             on
    SSLCertificateFile    ${SSL_CERTIFICATE_FILE}
    SSLCertificateKeyFile ${SSL_PRIVATE_KEY_FILE}

    # HTTP/2 support (requires SSLEngine on)
    Protocols             h2 http/1.1

    # Modern TLS settings
    SSLProtocol           all -SSLv3 -TLSv1 -TLSv1.1
    SSLCipherSuite        ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
    SSLHonorCipherOrder   off
    SSLSessionTickets     off

    # Security headers
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # ---------------------------------------------------------------------------
    # Correlation / request ID
    # mod_unique_id generates a unique token per request and stores it in the
    # UNIQUE_ID environment variable.  We forward it as X-Request-ID so clients
    # (browsers, curl, etc.) can quote it when reporting problems, and it is
    # also written into the access log (see combined_reqid format above).
    # ---------------------------------------------------------------------------
    Header always set X-Request-ID "%{UNIQUE_ID}e"

    # ---------------------------------------------------------------------------
    # Custom error documents
    # ---------------------------------------------------------------------------
    #
    # Customizable error responses come in three flavors:
    # 1) plain text 2) local redirects 3) external redirects
    #
    # Some examples:
    #ErrorDocument 500 "The server made a boo boo."
    #ErrorDocument 404 /missing.html
    #ErrorDocument 404 "/cgi-bin/missing_handler.pl"
    #ErrorDocument 402 http://www.example.com/subscription_info.html
    #
    ErrorDocument 403 /errors/403.html
    ErrorDocument 404 /errors/404.html
    ErrorDocument 500 /errors/500.html

    # ---------------------------------------------------------------------------
    # Adjust expire time on static elements
    # mod_expires instructs browsers to cache static assets locally, reducing
    # repeat requests and improving perceived load time.
    # ---------------------------------------------------------------------------
    ExpiresActive On
    ExpiresByType text/css             "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/gif            "access plus 1 month"
    ExpiresByType image/jpeg           "access plus 1 month"
    ExpiresByType image/png            "access plus 1 month"
    ExpiresByType image/svg+xml        "access plus 1 month"
    ExpiresByType image/x-icon         "access plus 1 year"
    ExpiresByType font/woff            "access plus 1 year"
    ExpiresByType font/woff2           "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # ---------------------------------------------------------------------------
    # Enable compression of static elements
    # mod_deflate reduces the size of text-based responses sent to clients,
    # lowering bandwidth consumption and speeding up page delivery.
    # ---------------------------------------------------------------------------
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml

    # ---------------------------------------------------------------------------
    # Logging
    # When SIMPLESAMLPHP_LOGGING_HANDLER=file, APACHE_LOG_DIR_INSTANCE points
    # at the per-container sub-directory under SIMPLESAMLPHP_LOG_DIR so that
    # Apache logs land on the same shared volume as the SimpleSAMLphp logs.
    # For all other handlers it falls back to /var/log/apache2 which the base
    # image symlinks to /dev/stdout and /dev/stderr, preserving 'docker logs'.
    # ---------------------------------------------------------------------------
    ErrorLog  ${APACHE_LOG_DIR_INSTANCE}/error.log
    CustomLog ${APACHE_LOG_DIR_INSTANCE}/access.log combined_reqid
</VirtualHost>
