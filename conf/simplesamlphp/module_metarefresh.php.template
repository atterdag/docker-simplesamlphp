<?php

/**
 * SimpleSAMLphp metarefresh module configuration – generated at container start
 * by docker-entrypoint.sh using envsubst(1).
 *
 * Environment variables substituted into this file:
 *   SIMPLESAMLPHP_METAREFRESH_CRON_TAG    – cron tag that triggers this set
