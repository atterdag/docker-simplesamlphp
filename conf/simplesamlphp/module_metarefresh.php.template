                     *
                     * Example (eduGAIN / SWAMID):
                     *   https://mds.edugain.org/edugain-v2.xml
                     */
                    'src' => '${SIMPLESAMLPHP_METAREFRESH_METADATA_URL}',

                    /*
                     * Uncomment and set to the path of the federation signing
                     * certificate to validate the metadata signature:
                     */
                    // 'certificates' => ['/var/simplesamlphp/cert/federation-signing.pem'],

                    /*
                     * Optional template applied to every entity parsed from
                     * this source.  Use it to tag entities or run authproc
                     * filters for all IdPs in this federation:
                     */
                    // 'template' => [
                    //     'tags'     => ['federation'],
                    //     'authproc' => [
                    //         51 => ['class' => 'core:AttributeMap', 'oid2name'],
