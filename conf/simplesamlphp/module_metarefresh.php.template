 *                                           (default: /var/simplesamlphp/metadata/metarefresh)
 *   SIMPLESAMLPHP_METAREFRESH_EXPIRE_AFTER – seconds after which cached
 *                                            metadata is considered stale
 *                                            (default: 345600 = 4 days)
 *
 * After the first successful refresh the output directory will contain one or
 * more PHP files (e.g. saml20-idp-remote.php) that SimpleSAMLphp reads via
 * the 'flatfile' metadata source added in config.php.
 *
 * To validate the metadata signature supply a PEM certificate:
 *   'certificates' => ['/var/simplesamlphp/cert/federation-signing.pem'],
 *
 * Multiple sources / federations can be added by duplicating the 'sources'
 * array entry below.
 */

$config = [

    'sets' => [

        'default' => [

            /*
             * Cron tag that must match an entry in module_cron.php
