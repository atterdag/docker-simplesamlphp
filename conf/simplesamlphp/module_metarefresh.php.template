             */
            'cron' => ['${SIMPLESAMLPHP_METAREFRESH_CRON_TAG}'],

            'sources' => [
                [
                    /*
                     * URL of the remote metadata aggregate (SAML 2.0 XML).
                     * Set SIMPLESAMLPHP_METAREFRESH_METADATA_URL to the URL
