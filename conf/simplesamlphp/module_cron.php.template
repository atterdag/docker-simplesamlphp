<?php

/**
 * SimpleSAMLphp cron module configuration – generated at container start by
 * docker-entrypoint.sh using envsubst(1).
 *
 * Environment variables substituted into this file:
 *   SIMPLESAMLPHP_CRON_SECRET           – secret key used to protect the cron
 *                                         HTTP trigger endpoint
 *   SIMPLESAMLPHP_METAREFRESH_CRON_TAG  – tag that the metarefresh set is bound
 *                                         to (default: metarefresh)
 *
 * Trigger the cron endpoint manually:
 *   curl "https://<FQDN>/simplesaml/module.php/cron/run/<tag>/<secret>"
 */

$config = [

    /*
     * Secret key that must be included in the cron URL to prevent unauthorised
     * triggering.  Auto-generated by the entrypoint when not explicitly set.
     */
    'key' => '${SIMPLESAMLPHP_CRON_SECRET}',

    /*
     * Tags that may be triggered via the HTTP endpoint.
     * 'daily' and 'hourly' are conventional; the metarefresh tag is also
     * included so that federation metadata can be refreshed on schedule.
     */
    'allowed_tags' => ['daily', 'hourly', '${SIMPLESAMLPHP_METAREFRESH_CRON_TAG}'],

    /*
     * Attach a human-readable summary to the HTTP response body.
     * Useful for confirming what happened during a manual run.
     */
    'debug_message' => true,

    /*
     * Send an e-mail report after each cron run.
     * Set to true and configure the mailer in config.php to receive reports.
     */
    'sendemail' => false,

];
